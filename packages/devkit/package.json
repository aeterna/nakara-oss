{
  "name": "@aeterna_game/fivem-devkit",
  "version": "0.1.1",
  "description": "Static checks, a code-safety scanner and a busted test harness for FiveM Lua/JS resources",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeterna/nakara-oss.git",
    "directory": "packages/devkit"
  },
  "homepage": "https://github.com/aeterna/nakara-oss/tree/main/packages/devkit#readme",
  "bugs": {
    "url": "https://github.com/aeterna/nakara-oss/issues"
  },
  "type": "module",
  "bin": {
    "fivem-devkit": "bin/fivem-devkit.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./busted/*": "./busted/*",
    "./safety": "./src/safety/index.js"
  },
  "files": [
    "bin",
    "src",
    "busted",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "fivem",
    "cfx",
    "qbox",
    "lua",
    "lint",
    "security",
    "busted"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "luaparse": "0.3.1"
  }
}
