# Run mode and port
ROLE=
PORT=

# Database connection
DATABASE_URL=
DATABASE_URL_FILE=

# Encryption key for transcripts and bridge secrets (32 bytes base64 / base64url)
TICKETS_DATA_KEY=
TICKETS_DATA_KEY_FILE=

# Discord bot credentials
DISCORD_TOKEN=
DISCORD_TOKEN_FILE=
DISCORD_APP_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_SECRET_FILE=

# Base public URL for dashboard and OAuth callbacks
PUBLIC_ORIGIN=

# Comma-separated list of Discord guild IDs allowed to use this instance
ALLOWED_GUILD_IDS=

# Local storage directory for ticket attachments and files
STORAGE_DIR=

# PostgreSQL database container settings (compose)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_FILE=

# Ingress domain for Caddy (compose profile caddy)
PUBLIC_DOMAIN=

# Cloudflare tunnel token (compose profile cloudflared)
TUNNEL_TOKEN=
TUNNEL_TOKEN_FILE=
